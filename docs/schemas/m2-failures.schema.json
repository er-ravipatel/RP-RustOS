{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M2 failed-operation design contracts",
  "$defs": {
    "failure": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 2,
          "type": "integer"
        },
        "record_kind": {
          "enum": [
            "preflight-failure",
            "build-failure",
            "report-recovery"
          ]
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "enum": [
            "build",
            "verify"
          ]
        },
        "method": {
          "enum": [
            null,
            "image",
            "hardware"
          ]
        },
        "target": {
          "enum": [
            null,
            "rpi-zero2w-a53"
          ]
        },
        "complete": {
          "const": false,
          "type": "boolean"
        },
        "terminal": {
          "const": true,
          "type": "boolean"
        },
        "status": {
          "enum": [
            "failed",
            "timed_out",
            "cancelled"
          ]
        },
        "started_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "manifest_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "diagnostics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "severity": {
                "enum": [
                  "info",
                  "warning",
                  "error"
                ]
              },
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "severity",
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "cleanup": {
          "type": "object",
          "properties": {
            "serial": {
              "enum": [
                "not_acquired",
                "closed",
                "unconfirmed"
              ]
            },
            "helpers": {
              "enum": [
                "not_started",
                "settled",
                "unconfirmed"
              ]
            }
          },
          "required": [
            "serial",
            "helpers"
          ],
          "additionalProperties": false
        },
        "build_stages": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "compilation": {
                  "enum": [
                    "passed",
                    "failed",
                    "timed_out",
                    "cancelled",
                    "skipped"
                  ]
                },
                "packaging": {
                  "enum": [
                    "passed",
                    "failed",
                    "timed_out",
                    "cancelled",
                    "skipped"
                  ]
                },
                "publication": {
                  "enum": [
                    "passed",
                    "failed",
                    "timed_out",
                    "cancelled",
                    "skipped"
                  ]
                }
              },
              "required": [
                "compilation",
                "packaging",
                "publication"
              ],
              "additionalProperties": false
            }
          ]
        },
        "attempted_report": {
          "type": [
            "object",
            "null"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "path",
              "sha256",
              "size_bytes"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schema_version",
        "record_kind",
        "run_id",
        "operation",
        "method",
        "target",
        "complete",
        "terminal",
        "status",
        "started_at",
        "finished_at",
        "manifest_sha256",
        "diagnostics",
        "cleanup",
        "build_stages",
        "attempted_report",
        "evidence"
      ],
      "additionalProperties": false
    },
    "failed_index": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 2,
          "type": "integer"
        },
        "record_kind": {
          "const": "failed-operation"
        },
        "id": {
          "type": "string",
          "pattern": "^e-[a-f0-9]+-[a-f0-9]+$"
        },
        "input_path": {
          "type": "string",
          "minLength": 1
        },
        "failure_path": {
          "type": "string",
          "minLength": 1
        },
        "failure_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "operation": {
          "enum": [
            "build",
            "verify"
          ]
        },
        "status": {
          "enum": [
            "failed",
            "timed_out",
            "cancelled"
          ]
        },
        "method": {
          "enum": [
            null,
            "image",
            "hardware"
          ]
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "schema_version",
        "record_kind",
        "id",
        "input_path",
        "failure_path",
        "failure_sha256",
        "operation",
        "status",
        "method",
        "run_id"
      ],
      "additionalProperties": false
    }
  }
}
